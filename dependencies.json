{
  "schema": "story-video-studio-dependencies",
  "schema_version": 1,
  "bundled_skills": [
    "story-video-project-studio",
    "story-development-director",
    "higgsfield-seedance-prompt",
    "ai-video-reference-asset-studio",
    "story-video-media-runtime",
    "goal-driven-video-qa"
  ],
  "runtime_skills": [
