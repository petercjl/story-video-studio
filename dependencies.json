    { "name": "seedance-video", "platform": "codex", "required_when": "video generation is requested" },
    { "name": "seedaudiocli", "platform": "codex", "required_when": "final BGM generation is requested" }
  ],
  "host_capabilities": [
    { "name": "sealseek-canvas.generate_image", "platform": "sealseek", "required_when": "image generation is requested" },
    { "name": "sealseek-canvas.generate_video", "platform": "sealseek", "required_when": "video generation is requested" }
  ],
  "executables": [
    { "name": "node", "resolution": "active process executable", "required_for": ["suite", "updates"] },
    { "name": "npm", "resolution": "managed Node npm CLI or PATH", "required_for": ["updates"] },
    { "name": "python", "resolution": "STORY_VIDEO_PYTHON, SealSeek managed Python, or PATH", "required_for": ["story", "segments", "prompts", "assets", "video-generation", "video-qa", "delivery"] },
    { "name": "ffmpeg", "resolution": "bundled npm binary with optional STORY_VIDEO_FFMPEG override", "required_for": ["video-qa", "assembly", "delivery"] },
    { "name": "ffprobe", "resolution": "bundled npm binary with optional STORY_VIDEO_FFPROBE override", "required_for": ["video-qa", "assembly", "delivery"] }
  ],
  "credentials": {
    "bundled": false,
    "source": "target Agent and provider configuration"
  }
}
