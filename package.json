{
  "name": "@petercjl/story-video-studio",
  "version": "0.3.0",
  "description": "Cross-Agent story video production workflow and managed Skill suite for Codex and SealSeek",
  "type": "module",
  "bin": {
    "story-video-studio": "bin/story-video-studio.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "suite.json",
    "dependencies.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:manifest": "node scripts/build-suite-manifest.mjs",
    "check:manifest": "node scripts/build-suite-manifest.mjs --check",
    "dependencies": "node scripts/check-dependencies.mjs",
    "privacy": "node scripts/privacy-scan.mjs",
    "test": "node --test",
    "check": "node --check bin/story-video-studio.mjs && node --check src/cli.mjs && node --check src/update.mjs && node --check src/skill.mjs && npm run check:manifest && npm run dependencies && npm run privacy && npm test && node scripts/run-python-tests.mjs && npm run privacy",
    "prepublishOnly": "npm run check && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/story-video-studio.git"
  },
  "homepage": "https://github.com/petercjl/story-video-studio#readme",
  "bugs": {
    "url": "https://github.com/petercjl/story-video-studio/issues"
  },
  "license": "UNLICENSED",
  "keywords": [
    "agent-skill",
    "sealseek",
    "codex",
    "story-video",
    "seedance"
  ],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2"
  }
}
